{
  "name": "cube-timer-activity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@napi-rs/canvas": "^1.0.11",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
